<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- AutoCAD 2027 loads .NET 10 add-ins and runs on 64-bit Windows only. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- AutoCAD supplies these assemblies at run time: compile against them, never copy them to the output. -->
    <PackageReference Include="AutoCAD.NET.Core" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cork.Core\Cork.Core.csproj" />
  </ItemGroup>
</Project>
